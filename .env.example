# =============================================================================
# ROBÔ DE LICITAÇÕES — ARQUIVO DE CONFIGURAÇÃO (.env)
# =============================================================================
#
# INSTRUÇÕES:
#   1. Copie este arquivo para .env:  cp .env.example .env
#   2. Preencha os valores entre os campos <...>com os dados reais.
#   3. NÃO COMPACTE o .env no git — ele está no .gitignore.
#
# MODO DE OPERAÇÃO:
#   - "simulation" ou "simulacao" = apenas simula lances, sem enviar nada
#   - "real" ou "producao"        = envia lances reais no Compras.gov.br
#   >>> POR PADRÃO SEMPRE SIMULATION <<<
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE (banco de dados, logs e licenças)
# ─────────────────────────────────────────────────────────────────────────────
# URL do seu projeto Supabase (ex: https://xyzabc.supabase.co)
SUPABASE_URL=<SUA_SUPABASE_URL>

# Chave de API do Supabase (service_role ou anon_key)
# Copie no dashboard: Settings → API → Service Role Key
SUPABASE_KEY=<SUA_SUPABASE_KEY>

# ─────────────────────────────────────────────────────────────────────────────
# GEMINI AI (Google Generative AI — leitura inteligente de editais)
# ─────────────────────────────────────────────────────────────────────────────
# Chave da API do Google Gemini.
# Gere em: https://console.cloud.google.com/ → APIs → Google Gemini API
# Ative as APIs "Google Generative AI" se necessário.
GEMINI_API_KEY=<SUA_GEMINI_API_KEY>

# ID do projeto Google Cloud (opcional — para rastreamento)
GCP_PROJECT_ID=<SEU_PROJETO_GCP>

# Região GCP padrão
GCP_REGION=southamerica-east1

# ─────────────────────────────────────────────────────────────────────────────
# MODO DE OPERAÇÃO DO ROBÔ
# ─────────────────────────────────────────────────────────────────────────────
# simulation = seguro (não envia lances reais)
# real       = lances reais (use apenas com confirmação explícita do usuário)
MODO_OPERACAO=simulation

# Margem mínima de lucro sobre o custo declarado (em %)
# Ex: 15% de margem sobre custo de R$ 100,00 → stop-loss = R$ 115,00
MARGEM_MINIMA_PERCENT=15.0

# ─────────────────────────────────────────────────────────────────────────────
# BROWSER / PLAYWRIGHT (navegação no Compras.gov.br)
# ─────────────────────────────────────────────────────────────────────────────
# Diretório para o perfil persistente do Chromium
# Mantém cookies e sessão autenticada entre execuções
BROWSER_USER_DATA_DIR=./browser_profile

# Timeout em milissegundos para operações do Playwright
BROWSER_TIMEOUT_MS=30000

# Se True, roda sem interface gráfica (headless).
# Deixe False para ver o navegador durante a automação.
BROWSER_HEADLESS=False

# ─────────────────────────────────────────────────────────────────────────────
# LOG / DEBUG
# ─────────────────────────────────────────────────────────────────────────────
# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tamanho máximo da fila de logs assíncronos para o Supabase
LOG_ASYNC_QUEUE_SIZE=500

# ─────────────────────────────────────────────────────────────────────────────
# URLS DO COMPRAS.GOV.BR
# ─────────────────────────────────────────────────────────────────────────────
COMPRASNET_BASE_URL=https://www.compras.gov.br
COMPRASNET_PREGO_URL=https://cnetmobile.estaleiro.serpro.gov.br/comprasnet-web/public/pregao

# ─────────────────────────────────────────────────────────────────────────────
# LICENÇA / ASSINATURA (para modelo de venda de cópias)
# ─────────────────────────────────────────────────────────────────────────────
# Chave de licença gerada pelo administrador.
# Se não estiver presente, o robô pede na primeira inicialização.
# CHAVE_LICENCA=<SUA_CHAVE_LICENCA>

# ─────────────────────────────────────────────────────────────────────────────
# ALERTAS (sistema de polling automático de oportunidades)
# ─────────────────────────────────────────────────────────────────────────────
# Intervalo em segundos entre cada varredura automática no PNCP
# 3600 = 1 hora | 1800 = 30 min | 600 = 10 min
ALERTA_POLLING_INTERVAL=3600

# Palavras-chave para filtrar oportunidades relevantes (separadas por vírgula)
# Ex: manutencao,informatica,TI,suporte,rede
ALERTA_PALAVRAS_CHAVE=manutencao,informatica,TI,suporte,rede,instalacao

# Estados (UFs) para monitorar (separados por vírgula)
# Ex: TO,PI,MA,GO,MT,RO
ALERTA_UFS=TO,PI,MA,GO,MT,RO

# Enviar alerta por terminal sempre que nova oportunidade for encontrada
ALERTA_TERMINAL=True

# Enviar alerta por mensagem popup na GUI (se estiver aberta)
ALERTA_GUI=True

# ─────────────────────────────────────────────────────────────────────────────
# LEGENDA DE VARIÁVEIS
# ─────────────────────────────────────────────────────────────────────────────
# <SUA_...>         → substituir pelo valor real
# Não incluir aspas ao redor dos valores
# Não deixar linhas em branco entre as variáveis
# =============================================================================
